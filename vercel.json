{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-assets.mjs",
  "outputDirectory": "public-assets",
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"},
      {"key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=5"},
      {"key": "X-Content-Type-Options", "value": "nosniff"}
    ]},
    {"source": "/:path*/:file([a-f0-9]{64}).:extension(json|jpg)", "headers": [
      {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"},
      {"key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=31536000"}
    ]}
  ]
}
